3) //linear probing collision handling technique
#include<iostream>
using namespace std;
int main()
{
    int m,i,key,nk,loc,j;
    cout<<"enter size of the hash table";
    cin>>m;
    int h[m];
    for(i=0;i<m;i++)
    {
        h[i]=-999;
    }
    cout<<"enter number of key elements";
    cin>>nk;
    for(i=0;i<nk;i++)
    {
        cout<<"enter key"<<i+1;
        cin>>key;
        loc=key%m;
        if(h[loc]==-999)
        {
            h[loc]=key;
        }
        else
        {
            j=0;
            while(h[loc]!=-999)
            {
                loc=(loc+j)%m;
                j++;
            }
            h[loc]=key;
        }
    }
    cout<<"hash table status\n";
    for(i=0;i<m;i++)
  {
      cout<<h[i]<<" ";
  }
}
  
